# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# Deployment URLs (reference):
#   This API  — prod: https://fa-web-api.vercel.app/               dev: https://dev-fa-web-api.vercel.app/
#   Frontend  — prod: https://finance-alumni-database.vercel.app/  dev: https://dev-fa-web-app.vercel.app/

# Application
ENVIRONMENT=development
DEBUG=true

# Allowed frontend origins for CORS (comma-separated).
CORS_ORIGINS=http://localhost:3000,https://finance-alumni-database.vercel.app,https://dev-fa-web-app.vercel.app

# Database (PostgreSQL / Supabase).
# A plain postgresql:// URL is upgraded to the asyncpg driver automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fa_alumni

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (anon) key — safe for clients, guarded by RLS.
SUPABASE_ANON_KEY=sb_publishable_xxx
# Service-role key — SECRET, server-only.
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret — only for HS256-signed projects. Leave blank to use JWKS
# (asymmetric RS256/ES256) verification via the Supabase project's endpoint.
JWT_SECRET=

# Survey email (Resend) — the annual "confirm your info" campaign.
# API key is SECRET, server-only. Leave blank and sends are disabled / dry-run.
RESEND_API_KEY=
# The verified sending domain address (e.g. byufinancealumni@mailing.byu.edu).
# For testing you can use an address on a domain you control, e.g. Namecheap.
SURVEY_FROM_EMAIL=
SURVEY_FROM_NAME=BYU Finance Alumni
# Frontend base URL used to build each recipient's /survey/<token> link.
SURVEY_APP_BASE_URL=https://finance.alumni.byu.edu
# Long random string that signs survey tokens.
SURVEY_TOKEN_SECRET=
# Max recipients actually sent per call (Resend Free plan = 100/day).
SURVEY_DAILY_CAP=100

# API failure alerting (#444) — one email when the API starts failing, one when
# it recovers. Comma-separated recipients. LEAVING THIS BLANK DISABLES ALERTING
# ENTIRELY, which is what you want locally and in CI. Sending reuses the Resend
# key above, so alerts are also off wherever RESEND_API_KEY is blank.
ALERT_EMAIL_TO=
# From-address for alerts. Blank falls back to SURVEY_FROM_EMAIL (one verified
# sending domain is all this app has).
ALERT_FROM_EMAIL=
ALERT_FROM_NAME=BYU Finance Alumni API
# Slack incoming-webhook URLs alerts are ALSO posted to (#456). TWO channels,
# because the two kinds of alert are read in two different moods:
#
#   SLACK_ALERT_WEBHOOK_URL     -> #error-alerts     the API is failing / recovered
#   SLACK_SECURITY_WEBHOOK_URL  -> #security-alerts  login brute force / abuse
#
# SAME RULE AS ALERT_EMAIL_TO: leaving one blank disables THAT channel, which is
# what you want locally and in CI. Every channel is independent -- email only, one
# Slack channel, both, all three, or nothing.
#
# FALLBACK, one direction only: if SLACK_SECURITY_WEBHOOK_URL is blank but
# SLACK_ALERT_WEBHOOK_URL is set, security alerts go to the ERROR channel rather
# than being dropped -- a forgotten env var must never become silence about an
# attack. The reverse does NOT happen: outage alerts never divert into the
# security channel. Each Slack message is tagged `SECURITY` or `OUTAGE` up front
# so a fallback-mixed channel still reads correctly at a glance.
#
# ⚠️ These URLs are CREDENTIALS: anyone who has one can post to that channel. Treat
# them like passwords, keep them out of the frontend, and rotate (delete and
# re-add the webhook in Slack) if one ever leaks.
SLACK_ALERT_WEBHOOK_URL=
SLACK_SECURITY_WEBHOOK_URL=
# THIRD channel (#771): an alumnus sent us something a human has to action -- today
# that is a job posting arriving through the survey. Same on/off rule, and the SAME
# one-direction fallback as the security channel: blank here + SLACK_ALERT_WEBHOOK_URL
# set means postings land in #error-alerts rather than being dropped. #771 exists
# because nothing notified anybody, so this channel must never go quietly dark.
# Messages are tagged `POSTING`.
SLACK_SUBMISSION_WEBHOOK_URL=

# How survey job postings are announced (#771). Optional.
#   per_posting   DEFAULT (and what an unset or misspelled value means): one message
#                 per submission, immediately -- "so we never miss".
#   daily_digest  one message a day instead. ALSO REQUIRES the cron entry
#                 {"path": "/opportunity-links/cron/digest", "schedule": "0 17 * * *"}
#                 in vercel.json, or nothing will send.
OPPORTUNITY_LINK_NOTIFY_MODE=

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET`.
# Unset = the cron endpoints reject every request.
CRON_SECRET=
